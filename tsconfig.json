{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "allowJs": true, "checkJs": true, "isolatedModules": true, "verbatimModuleSyntax": true,
    "resolveJsonModule": true, "esModuleInterop": true, "forceConsistentCasingInFileNames": true,
    "strict": true, "skipLibCheck": true, "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".", "paths": { "$lib/*": ["src/lib/*"] }, "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts"]
}
